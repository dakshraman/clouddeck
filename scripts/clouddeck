#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const crypto = require("node:crypto");
const readline = require("node:readline");
const { spawnSync } = require("node:child_process");

const USERNAME_RE = /^[a-zA-Z0-9._-]{3,32}$/;
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const BCRYPT_ROUNDS = 10;

// --- Uni 6-Color Palette ANSI Styling & Terminal Capabilities ---------------

const useColor = !process.env.NO_COLOR && (process.stdout.isTTY || process.env.FORCE_COLOR);
const esc = "\x1b";

const tcSky      = useColor ? `${esc}[38;2;116;184;204m` : "";  // #74B8CC
const tcMarine   = useColor ? `${esc}[38;2;35;83;97m`   : "";  // #235361
const tcPeach    = useColor ? `${esc}[38;2;250;170;147m` : "";  // #FAAA93
const tcSteel    = useColor ? `${esc}[38;2;100;148;172m` : "";  // #6494AC
const tcChestnut = useColor ? `${esc}[38;2;136;99;81m`   : "";  // #886351
const tcMauve    = useColor ? `${esc}[38;2;210;173;172m` : "";  // #D2ADAC
const clrBold    = useColor ? `${esc}[1m`                : "";
const clrDim     = useColor ? `${esc}[2m`                : "";
const clrReset   = useColor ? `${esc}[0m`                : "";
const clrGreen   = useColor ? `${esc}[38;2;52;199;89m`   : "";  // Success Green
const clrYellow  = useColor ? `${esc}[38;2;255;204;0m`  : "";  // Warning Yellow
const clrRed     = useColor ? `${esc}[38;2;255;59;48m`   : "";  // Error Red
const clrCyan    = useColor ? `${esc}[38;2;90;200;250m`  : "";

const isModernConsole = !process.env.WINDIR || process.env.WT_SESSION || process.env.TERM_PROGRAM === "vscode";

const gArrow    = isModernConsole ? "❯" : ">";
const gCheck    = isModernConsole ? "✔" : "[OK]";
const gWarn     = isModernConsole ? "▲" : "[!]";
const gErr      = isModernConsole ? "✖" : "[X]";
const gRadioOn  = isModernConsole ? "●" : "(*)";
const gRadioOff = isModernConsole ? "○" : "( )";
const gBullet   = isModernConsole ? "•" : "*";
const gRailTop  = isModernConsole ? "╭─" : "+--";
const gRailMid  = isModernConsole ? "│"  : "|";
const gRailDiv  = isModernConsole ? "├─" : "+--";
const gRailBot  = isModernConsole ? "╰─" : "+--";

function stripAnsi(str) {
  return String(str || "").replace(/\x1b\[[0-9;]*m/g, "");
}

function badge(text, type = "info") {
  if (!useColor) return `[${text}]`;
  if (type === "success" || type === "active" || type === "running" || type === "pass") {
    return `${clrGreen}${gRadioOn} ${text}${clrReset}`;
  }
  if (type === "warn" || type === "warning" || type === "starting") {
    return `${clrYellow}${gRadioOn} ${text}${clrReset}`;
  }
  if (type === "error" || type === "fail" || type === "failed") {
    return `${clrRed}${gErr} ${text}${clrReset}`;
  }
  if (type === "dim" || type === "stopped" || type === "inactive") {
    return `${clrDim}${gRadioOff} ${text}${clrReset}`;
  }
  return `${tcPeach}${text}${clrReset}`;
}

function progressBar(percent, width = 12) {
  const p = Math.max(0, Math.min(100, percent));
  const filled = Math.round((p / 100) * width);
  const empty = width - filled;
  const bar = "■".repeat(filled) + "□".repeat(empty);
  const color = p > 85 ? clrRed : p > 65 ? clrYellow : clrGreen;
  return `${color}[${bar}]${clrReset} ${p.toFixed(1)}%`;
}

function formatBytes(bytes) {
  if (!bytes || isNaN(bytes) || bytes <= 0) return "0 B";
  const units = ["B", "KB", "MB", "GB", "TB"];
  const i = Math.floor(Math.log(bytes) / Math.log(1024));
  return `${(bytes / Math.pow(1024, i)).toFixed(1)} ${units[i] || "TB"}`;
}

function printCard(title, lines) {
  const cleanTitle = stripAnsi(title);
  const totalWidth = 72;
  const fillWidth = Math.max(4, totalWidth - cleanTitle.length - 5);
  console.log(`\n  ${tcSky}${clrBold}${gRailTop} ${title} ${"─".repeat(fillWidth)}${clrReset}`);
  for (const line of lines) {
    if (line === "---") {
      console.log(`  ${tcSky}${gRailDiv}${"─".repeat(totalWidth - 3)}${clrReset}`);
    } else {
      console.log(`  ${tcSky}${gRailMid}${clrReset}  ${line}`);
    }
  }
  console.log(`  ${tcSky}${gRailBot}${"─".repeat(totalWidth - 3)}${clrReset}\n`);
}

function printTable(headers, rows) {
  if (!rows || rows.length === 0) {
    console.log(`  ${clrDim}(no records found)${clrReset}\n`);
    return;
  }
  const colWidths = headers.map((h, i) => {
    let max = stripAnsi(h).length;
    for (const r of rows) {
      const cellLen = stripAnsi(String(r[i] !== undefined ? r[i] : "")).length;
      if (cellLen > max) max = cellLen;
    }
    return Math.max(max + 2, 6);
  });

  const headerLine = headers.map((h, i) => {
    const rawLen = stripAnsi(h).length;
    return `${clrBold}${h}${clrReset}${" ".repeat(colWidths[i] - rawLen)}`;
  }).join("");

  const divider = colWidths.map(w => "─".repeat(w - 1) + " ").join("");

  console.log(`  ${headerLine}`);
  console.log(`  ${clrDim}${divider}${clrReset}`);
  for (const r of rows) {
    const rowLine = r.map((cell, i) => {
      const text = String(cell !== undefined ? cell : "");
      const rawLen = stripAnsi(text).length;
      const pad = Math.max(0, colWidths[i] - rawLen);
      return `${text}${" ".repeat(pad)}`;
    }).join("");
    console.log(`  ${rowLine}`);
  }
  console.log("");
}

// --- Levenshtein Distance Typo Suggester -------------------------------------

function levenshtein(a, b) {
  const m = a.length, n = b.length;
  const d = Array.from({ length: m + 1 }, () => Array(n + 1).fill(0));
  for (let i = 0; i <= m; i++) d[i][0] = i;
  for (let j = 0; j <= n; j++) d[0][j] = j;
  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
    }
  }
  return d[m][n];
}

const ALL_COMMANDS = [
  "status", "doctor", "open", "start", "stop", "restart", "logs",
  "site", "app", "db", "cache", "ssl", "backup", "fleet", "security",
  "firewall", "user", "passwd", "reset-password", "update", "version",
  "reinstall", "uninstall", "help"
];

function findSuggestion(input) {
  if (!input) return null;
  let best = null;
  let bestDist = Infinity;
  for (const cmd of ALL_COMMANDS) {
    const dist = levenshtein(input.toLowerCase(), cmd);
    if (dist < bestDist && dist <= 2) {
      bestDist = dist;
      best = cmd;
    }
  }
  return best;
}

// --- install layout ---------------------------------------------------------

function readEnvFile(file) {
  let text;
  try {
    text = fs.readFileSync(file, "utf8");
  } catch (err) {
    if (err.code === "ENOENT") return {};
    throw err;
  }
  const values = {};
  for (const line of text.split(/\r?\n/)) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) continue;
    const eq = trimmed.indexOf("=");
    if (eq <= 0) continue;
    values[trimmed.slice(0, eq).trim()] = trimmed.slice(eq + 1).trim();
  }
  return values;
}

function tryReadEnvFile(file) {
  try {
    return readEnvFile(file);
  } catch {
    return {};
  }
}

function derivePrefix() {
  const script = process.argv[1] || __filename;
  try {
    return path.resolve(path.dirname(fs.realpathSync(script)), "..");
  } catch {
    return path.resolve(__dirname, "..");
  }
}

const ENV_PREFIX = process.env.CLOUDDECK_PREFIX
  ? path.resolve(process.env.CLOUDDECK_PREFIX)
  : null;
let PREFIX = ENV_PREFIX || derivePrefix();

let installConfig = {};
let configError = null;
try {
  installConfig = readEnvFile(path.join(PREFIX, ".clouddeck-install"));
} catch (err) {
  if (!process.getuid || process.getuid() === 0) configError = err;
}

const defaultDataDir =
  process.platform === "darwin"
    ? path.join(os.homedir(), ".clouddeck", "data")
    : process.platform === "win32"
    ? path.join(process.env.LOCALAPPDATA || process.env.USERPROFILE || "C:\\", ".clouddeck", "data")
    : "/var/lib/clouddeck";

const defaultEtcDir =
  process.platform === "darwin"
    ? path.join(os.homedir(), ".clouddeck", "etc")
    : process.platform === "win32"
    ? path.join(process.env.LOCALAPPDATA || process.env.USERPROFILE || "C:\\", ".clouddeck", "etc")
    : "/etc/clouddeck";

const DATADIR = installConfig.DATADIR || defaultDataDir;
const ETCDIR = installConfig.ETCDIR || defaultEtcDir;
const AGENT_PORT = installConfig.AGENT_PORT || "9090";
const PANEL_PORT = installConfig.PANEL_PORT || "2083";
const REPO = installConfig.REPO || "dakshraman/clouddeck";
const NO_SYSTEMD = installConfig.NO_SYSTEMD || "0";
const DO_AGENT = installConfig.DO_AGENT !== undefined ? installConfig.DO_AGENT : "1";
const DO_PANEL = installConfig.DO_PANEL !== undefined ? installConfig.DO_PANEL : "1";
const FAST = installConfig.FAST || "0";
const SYSTEM_NODE = installConfig.SYSTEM_NODE || "0";

function panelDataDir() {
  const env = tryReadEnvFile(path.join(ETCDIR, "panel.env"));
  return env.PANEL_DATA_DIR || path.join(DATADIR, "panel");
}

function usersFile() {
  return path.join(panelDataDir(), "users.json");
}

function installedVersion() {
  try {
    return fs.readFileSync(path.join(PREFIX, ".clouddeck-version"), "utf8").trim() || null;
  } catch {
    return "0.6.57";
  }
}

// --- errors / output --------------------------------------------------------

function die(message) {
  console.error(`  ${clrRed}${gErr} [ERROR] ${message}${clrReset}`);
  process.exit(1);
}

function usageError(message) {
  if (message) console.error(`  ${clrRed}${gErr} ${message}${clrReset}\n`);
  console.error(helpText());
  process.exit(2);
}


# URL of the CloudDeck agent
AGENT_URL=http://127.0.0.1:9090

# Secret used to sign session cookies. MUST be changed in production.
PANEL_SESSION_SECRET=dev-secret-change-me

# Where the panel stores its own data (users.json etc.)
PANEL_DATA_DIR=./data

# Optional unattended provisioning: uncomment BOTH to create the admin
# account on first start and skip the web setup wizard.
# PANEL_SEED_ADMIN=admin
# PANEL_SEED_PASSWORD=change-me
